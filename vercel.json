{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm --prefix vue-frontend run build",
  "outputDirectory": "vue-frontend/dist",
  "installCommand": "npm --prefix vue-frontend ci",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
